// SSL (with OCSP stapling), stream routes and an open object with extra keys.
amends "../../src/Standalone.pkl"

ssls {
  new {
    id = "test"
    snis { "test.example.com" }
    cert = read("../fixtures/test.crt").text
    key = read("../fixtures/test.key").text
    ocsp_stapling { enabled = false; cache_ttl = 600 }
  }
}

upstreams {
  new { id = "tcp"; nodes = new Mapping { ["10.0.0.5:6379"] = 1 } }
}

stream_routes {
  new {
    id = "redis"
    server_port = 9100
    upstream_id = "tcp"
    plugins {
      `ip-restriction` { whitelist { "10.0.0.0/8" } }
      `limit-conn` { conn = 100; burst = 50; default_conn_delay = 0.1; key = "remote_addr" }
    }
  }
}

routes {
  new {
    id = "chat"
    uri = "/v1/chat/completions"
    plugins {
      `ai-proxy` {
        provider = "openai"
        auth { header { ["Authorization"] = "Bearer sk-test" } }
        // `options` is an open object: named keys are typed, other keys go in `extra`.
        options {
          model = "gpt-4o"
          extra { ["max_tokens"] = 512; ["temperature"] = 0.2 }
        }
      }
    }
  }
  new {
    id = "tls-only"
    uri = "/secure"
    hosts { "test.example.com" }
    plugins { `ocsp-stapling` {} }
    upstream { nodes = new Mapping { ["httpbin.org:443"] = 1 }; scheme = "https" }
  }
}
