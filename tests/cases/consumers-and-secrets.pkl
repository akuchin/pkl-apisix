// Consumers, consumer groups, credentials, secrets and plugin metadata.
amends "../../src/Standalone.pkl"

import "../../src/Apisix.pkl"

consumer_groups {
  new {
    id = "partners"
    plugins { `limit-count` { count = 1000; time_window = 60 } }
  }
}

consumers {
  new Apisix.Consumer {
    username = "jack"
    group_id = "partners"
    plugins { `key-auth` { key = "jack-key-1" } }
  }
  // A credential: id is "<consumer username>/credentials/<credential id>".
  new Apisix.Credential {
    id = "jack/credentials/jwt"
    plugins { `jwt-auth` { key = "jack-jwt"; secret = "jack-jwt-secret-that-is-long-enough" } }
  }
}

secrets {
  new Apisix.VaultSecret {
    id = "vault/main"
    uri = "https://vault.example.com:8200"
    prefix = "kv/apisix"
    token = "s.token"
  }
}

routes {
  new {
    id = "private"
    uri = "/private"
    plugins {
      `key-auth` {}
      `jwt-auth` {}
      `consumer-restriction` { whitelist { "jack" } }
      `http-logger` { uri = "http://logs.example.com/apisix"; batch_max_size = 10 }
    }
    upstream { nodes = new Mapping { ["httpbin.org:80"] = 1 } }
  }
}

plugin_metadata {
  `http-logger` {
    log_format { ["host"] = "$host"; ["client_ip"] = "$remote_addr" }
  }
}
